#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=config/syswatch.conf
# shellcheck source=lib/vitals.sh
# shellcheck source=lib/services.sh
if [[ -f "$SCRIPT_DIR/config/syswatch.conf" ]]; then
  source "$SCRIPT_DIR/config/syswatch.conf"
  source "$SCRIPT_DIR/lib/vitals.sh"
  source "$SCRIPT_DIR/lib/services.sh"
else
  source "/etc/syswatch/syswatch.conf"
  source "/usr/lib/syswatch/vitals.sh"
  source "/usr/lib/syswatch/services.sh"
fi

# ANSI Colors & Styles
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

print_header() {
  clear
  echo -e "${CYAN}${BOLD}==================================================${NC}"
  echo -e "${CYAN}${BOLD}           SYSWATCH — System Health CLI           ${NC}"
  echo -e "${CYAN}${BOLD}==================================================${NC}"
  # shellcheck disable=SC2002
  echo -e " Host: $(hostname) | OS: $(grep -oP '(?<=PRETTY_NAME=")[^"]*' /etc/os-release 2>/dev/null || uname -r)"
  echo -e " Time: $(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${CYAN}--------------------------------------------------${NC}"
}

show_help() {
  echo "Usage: syswatch [options]"
  echo ""
  echo "Options:"
  echo "  -w, --watch     Run continuously in live dashboard mode (refresh every 2s)"
  echo "  -h, --help      Display this help message"
}

main() {
  print_header
  check_cpu
  check_memory
  check_disk
  check_services
  check_docker
  echo -e "\n${CYAN}${BOLD}==================================================${NC}"
}

case "${1:-}" in
  -w|--watch)
    while true; do
      main
      sleep 2
    done
    ;;
  -h|--help)
    show_help
    ;;
  "")
    main
    ;;
  *)
    echo "Unknown option: $1"
    show_help
    exit 1
    ;;
esac