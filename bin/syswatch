#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# shellcheck source=config/syswatch.conf
# shellcheck source=lib/vitals.sh
# shellcheck source=lib/services.sh
# shellcheck source=lib/processes.sh
if [[ -f "$SCRIPT_DIR/config/syswatch.conf" ]]; then
  source "$SCRIPT_DIR/config/syswatch.conf"
  source "$SCRIPT_DIR/lib/vitals.sh"
  source "$SCRIPT_DIR/lib/services.sh"
  source "$SCRIPT_DIR/lib/processes.sh"
else
  source "/etc/syswatch/syswatch.conf"
  source "/usr/lib/syswatch/vitals.sh"
  source "/usr/lib/syswatch/services.sh"
  source "/usr/lib/syswatch/processes.sh"
fi

# ANSI Colors & Styles
# shellcheck disable=SC2034
readonly RED='\033[0;31m'
# shellcheck disable=SC2034
readonly GREEN='\033[0;32m'
# shellcheck disable=SC2034
readonly YELLOW='\033[1;33m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

print_header() {
  clear
  echo -e "${CYAN}${BOLD}==================================================${NC}"
  echo -e "${CYAN}${BOLD}           SYSWATCH — System Health CLI           ${NC}"
  echo -e "${CYAN}${BOLD}==================================================${NC}"
  # shellcheck disable=SC2002
  echo -e " Host: $(hostname) | OS: $(grep -oP '(?<=PRETTY_NAME=")[^"]*' /etc/os-release 2>/dev/null || uname -r)"
  echo -e " Time: $(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${CYAN}--------------------------------------------------${NC}"
}

show_help() {
  echo "Usage: syswatch [options]"
  echo ""
  echo "Options:"
  echo "  -w, --watch            Run continuously in live dashboard mode (refresh every 2s)"
  echo "  -s, --stop <svc...>    Stop one or more specified service daemons"
  echo "      --start <svc...>   Start one or more specified service daemons"
  echo "      --restart <svc...> Restart one or more specified service daemons"
  echo "  -h, --help             Display this help message"
}

stop_services() {
  local services=("${@}")
  if (( ${#services[@]} == 0 )); then
    echo "Error: No services specified to stop."
    echo "Usage: syswatch --stop <service1> [service2 ...]"
    exit 1
  fi

  echo "Stopping requested services..."
  for s in "${services[@]}"; do
    local unit="$s"
    [[ "$unit" != *.service ]] && unit="${unit}.service"
    
    echo -n "  • Stopping $s... "
    if sudo systemctl stop "$unit" 2>/dev/null; then
      echo -e "${GREEN}SUCCESS${NC}"
    else
      echo -e "${RED}FAILED (Check name or permissions)${NC}"
    fi
  done
}

start_services() {
  local services=("${@}")
  if (( ${#services[@]} == 0 )); then
    echo "Error: No services specified to start."
    echo "Usage: syswatch --start <service1> [service2 ...]"
    exit 1
  fi

  echo "Starting requested services..."
  for s in "${services[@]}"; do
    local unit="$s"
    [[ "$unit" != *.service ]] && unit="${unit}.service"
    
    echo -n "  • Starting $s... "
    if sudo systemctl start "$unit" 2>/dev/null; then
      echo -e "${GREEN}SUCCESS${NC}"
    else
      echo -e "${RED}FAILED (Check name or permissions)${NC}"
    fi
  done
}

restart_services() {
  local services=("${@}")
  if (( ${#services[@]} == 0 )); then
    echo "Error: No services specified to restart."
    echo "Usage: syswatch --restart <service1> [service2 ...]"
    exit 1
  fi

  echo "Restarting requested services..."
  for s in "${services[@]}"; do
    local unit="$s"
    [[ "$unit" != *.service ]] && unit="${unit}.service"
    
    echo -n "  • Restarting $s... "
    if sudo systemctl restart "$unit" 2>/dev/null; then
      echo -e "${GREEN}SUCCESS${NC}"
    else
      echo -e "${RED}FAILED (Check name or permissions)${NC}"
    fi
  done
}

main() {
  print_header
  check_cpu
  check_memory
  check_disk
  check_services
  check_docker
  check_processes
  echo -e "\n${CYAN}${BOLD}==================================================${NC}"
}

case "${1:-}" in
  -w|--watch)
    while true; do
      main
      sleep 2
    done
    ;;
  -s|--stop)
    shift
    stop_services "$@"
    ;;
  --start)
    shift
    start_services "$@"
    ;;
  --restart)
    shift
    restart_services "$@"
    ;;
  -h|--help)
    show_help
    ;;
  "")
    main
    ;;
  *)
    echo "Unknown option: $1"
    show_help
    exit 1
    ;;
esac